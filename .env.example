# Public template only. Never commit real credentials.
OPENAI_API_KEY=put_your_openai_key_here

# Optional for Bybit features. Prefer entering credentials through the app UI
# on Windows, where the project stores them using DPAPI-bound local encryption.
BYBIT_API_KEY=put_your_bybit_api_key_here
BYBIT_API_SECRET=put_your_bybit_api_secret_here
